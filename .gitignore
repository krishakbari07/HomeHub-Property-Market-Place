# =============================================================================
# HomeHub Root .gitignore
# =============================================================================

# Dependencies
node_modules/
**/node_modules/
jspm_packages/
/.pnp
.pnp.js

# Environment and sensitive credential files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example
*.pem
*.key
*.cert
*.crt

# Production build and test outputs
dist/
build/
out/
coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Git backup directories & archive outputs
*-git-backup/
*git-backup*/
frontend-git-backup/
backend-git-backup/
backups/
*.bak

# System and OS files
.DS_Store
Thumbs.db

# Sensitive local maintenance / test scripts
scripts/resetAdminPassword.js
scripts/inspectAgents.js
scripts/inspectListings.js
**/scripts/resetAdminPassword.js
**/scripts/inspectAgents.js
**/scripts/inspectListings.js
