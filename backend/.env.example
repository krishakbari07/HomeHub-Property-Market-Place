# -------------------------------------------------------------
# HomeHub Backend Environment Configuration
# -------------------------------------------------------------

# Server Port (Render / Railway / Heroku dynamically provides PORT)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/homehub?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a secure 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here

# Single Admin System Configuration
ADMIN_EMAIL=admin@homehub.com
ADMIN_PASSWORD=your_secure_admin_password

# Allowed Frontend Origins for CORS (comma-separated if multiple)
FRONTEND_URL=https://homehub.vercel.app,http://localhost:3000

# -------------------------------------------------------------
# Google Gemini AI Configuration (https://aistudio.google.com/app/apikey)
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
